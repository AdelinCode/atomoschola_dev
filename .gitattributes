# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly LF for web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files - no conversion
*.jpeg binary
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.docx binary
